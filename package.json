{
  "name": "dsh-file-scout",
  "version": "0.1.2",
  "description": "IDEA-style workspace file palette for DSH: Ctrl+P opens ripgrep-backed name search, Ctrl+Shift+F opens full-text regex content search, and results open in dsh-better-sidebar's editor at the match line.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "dsh-better-sidebar": "^0.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "wrchuan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimGoo0/dsh-file-scout.git"
  },
  "homepage": "https://github.com/SimGoo0/dsh-file-scout#readme",
  "bugs": {
    "url": "https://github.com/SimGoo0/dsh-file-scout/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "file-search",
    "content-search",
    "ripgrep",
    "command-palette"
  ]
}
